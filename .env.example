# Optional when a server persistence adapter is added. Never expose secrets as VITE_ variables.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=replace-with-a-rotated-token
# Set this to the OpenAuth issuer URL to enable email/password authentication in the web app.
# VITE_OPENAUTH_ISSUER=http://127.0.0.1:3001
# VITE_API_MODE=server
# AUTH_PORT=3001
# OPENAUTH_STORAGE=.retain-auth.json
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=Retain <onboarding@resend.dev>
