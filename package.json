{
  "name": "retain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:auth": "tsx auth/index.ts",
    "dev:api": "tsx server/index.ts",
    "dev:full": "concurrently \"vite\" \"tsx auth/index.ts\" \"tsx server/index.ts\"",
    "db:migrate": "tsx server/migrate.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@libsql/client": "^0.17.4",
    "@openauthjs/openauth": "^0.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "hono": "^4.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.0",
    "typescript": "^5.7.3",
    "valibot": "^1.4.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.4",
    "jsdom": "latest",
    "tsx": "^4.23.1",
    "vitest": "latest"
  }
}
